# Configuración del Servidor HTTP
PORT=5000
NODE_ENV=development

# Base de Datos local (para Docker, usa mongodb://mongodb:27017/club_deportivo)
MONGO_URI=mongodb://localhost:27017/club_deportivo

# Seguridad y Criptografía
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# URLs Autorizadas (CORS)
FRONTEND_URL=http://localhost:5173, http://192.168.1.176:5173
